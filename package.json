{
  "name": "starforge",
  "version": "0.1.0",
  "private": true,
  "description": "Starforge: a 3D co-op incremental mining game (client, optional server and shared rules).",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "build:site": "npm run build:site -w client",
    "test": "npm test -w shared",
    "typecheck": "npm run typecheck --workspaces",
    "balance": "tsx shared/scripts/balance.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  }
}
